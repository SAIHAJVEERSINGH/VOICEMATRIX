<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090d18" />
    <meta name="description" content="VOICEMATRIX — Experimental AI voice-clone detection and scam prevention." />
    <title>VOICEMATRIX | Voice Intelligence</title>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.jsx"></script>
  
<script id="vm-phase2-launcher-script">
(() => {
  if (document.getElementById("vm-phase2-launcher")) return;

  const style = document.createElement("style");
  style.textContent = `
    #vm-phase2-launcher {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 99999;
      font-family: system-ui, sans-serif;
    }
    #vm-phase2-toggle {
      border: 1px solid #75e6c0;
      border-radius: 12px;
      background: #10251f;
      color: #aaffdf;
      padding: 13px 18px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 8px 30px #0005;
    }
    #vm-phase2-panel {
      width: 265px;
      margin-bottom: 10px;
      padding: 17px;
      border: 1px solid #34564e;
      border-radius: 15px;
      background: #101a27;
      color: #eaf0ff;
      box-shadow: 0 12px 40px #0008;
    }
    #vm-phase2-panel[hidden] { display: none; }
    #vm-phase2-panel strong {
      display: block;
      margin-bottom: 4px;
      font-size: 16px;
    }
    #vm-phase2-panel p {
      color: #aab8ca;
      font-size: 12px;
      margin: 0 0 13px;
    }
    #vm-phase2-panel a {
      display: block;
      margin-top: 9px;
      padding: 11px;
      border-radius: 9px;
      background: #1b2b3d;
      color: #aaffdf;
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
    }
    #vm-phase2-panel a:hover { background: #29423e; }
    @media(max-width:480px) {
      #vm-phase2-launcher { right: 12px; bottom: 12px; }
    }
  `;
  document.head.appendChild(style);

  const wrapper = document.createElement("div");
  wrapper.id = "vm-phase2-launcher";

  wrapper.innerHTML = `
    <nav id="vm-phase2-panel" hidden aria-label="Phase 2 tools">
      <strong>VOICEMATRIX Phase 2</strong>
      <p>Experimental voice-analysis tools</p>
      <a href="/live-monitor.html">Live Voice Monitor ?</a>
      <a href="/partial-fake.html">Partial-Fake Detection ?</a>
    </nav>
    <button
      type="button"
      id="vm-phase2-toggle"
      aria-expanded="false"
      aria-controls="vm-phase2-panel">
      Phase 2 Tools ?
    </button>
  `;

  document.body.appendChild(wrapper);

  const toggle = document.getElementById("vm-phase2-toggle");
  const panel = document.getElementById("vm-phase2-panel");

  toggle.addEventListener("click", () => {
    const opening = panel.hidden;
    panel.hidden = !opening;
    toggle.setAttribute("aria-expanded", String(opening));
  });
})();
</script>

</body>
</html>
